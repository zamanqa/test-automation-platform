# Copy to .env and fill in. .env is git-ignored — never commit real values.
# Only development is targeted. Each group is validated the first time a test uses it,
# so you can run the API suites without filling in the hub/checkout values.

# ---------- Hub (UI) ----------
HUB_URL=https://hub.development.circuly.io/
HUB_USER_EMAIL=
HUB_USER_PASSWORD=
HUB_COMPANY_NAME=circuly shopify stripe
HUB_API_HEALTH_URL=https://core.api.development.circuly.io/v1/version

# ---------- Hub (Lumen) API, used to trigger crons ----------
HUB_API_BASE_URL=https://circuly-lumen.herokuapp.com
HUB_API_EMAIL=
HUB_API_PASSWORD=

# ---------- Checkout (UI) ----------
CHECKOUT_URL=https://checkout-development-220082022725.europe-west3.run.app/en/
CHECKOUT_API_URL=https://hz-dev.checkout-api.circuly.org/v1/version

# ---------- CSS (UI, customer self-service) ----------
CSS_URL=https://css.development.circuly.io/en/auth/login?company_id=734f-4c766638po

# ---------- POS (UI, point of sale) ----------
POS_URL=https://pos.development.circuly.io/en/auth/login?company_id=734f-4c766638po
POS_LOCATION_ID=
POS_PASSWORD=

# ---------- Customer API (old, basic auth) ----------
CUSTOMER_API_BASE_URL=
CUSTOMER_API_VERSION=
CUSTOMER_API_USERNAME=
CUSTOMER_API_PASSWORD=
CUSTOMER_API_COMPANY_ID=

# ---------- Unified Customer API (new, JWT) ----------
UNIFIED_API_BASE_URL=
UNIFIED_API_VERSION=2026-04
UNIFIED_API_CONSUMER_KEY=
UNIFIED_API_CONSUMER_SECRET=

# ---------- Databases (all projects can use every database) ----------
HUB_DB_HOST=
HUB_DB_PORT=5432
HUB_DB_NAME=postgres
HUB_DB_USER=
HUB_DB_PASSWORD=

CHECKOUT_DB_HOST=
CHECKOUT_DB_PORT=5432
CHECKOUT_DB_NAME=
CHECKOUT_DB_USER=
CHECKOUT_DB_PASSWORD=

# ---------- Test data ----------
# Everything tests create is tagged with this prefix so it can be found and cleaned up.
TEST_DATA_PREFIX=qa_auto_
